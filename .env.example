# ------------------------------------------------------------------
# Veolia Digital Intelligence — environment template
# Copy to .env (or run `npm run setup`, which generates strong secrets).
# Never commit a real .env file.
# ------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=8787
# Public base URL of the application (used for cookies, links in e-mails)
APP_BASE_URL=http://localhost:5173

# Database
# Leave DATABASE_URL empty to use the embedded PostgreSQL (PGlite) stored in DATA_DIR.
# Production: postgres://user:password@host:5432/veolia_di?sslmode=require
DATABASE_URL=
DATA_DIR=./.data

# Security (REQUIRED in production)
# 32-byte key, base64. Used for AES-256-GCM encryption of connector secrets at rest.
APP_ENCRYPTION_KEY=
# Session idle timeout in minutes (overridable in Administration → Security)
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12

# Demo mode
# DEMO_MODE=true serves deterministic synthetic data for every source that has no live connection.
DEMO_MODE=true
# DEMO_LOGIN=true shows one-click demo role sign-in on the login page.
# It is ignored when NODE_ENV=production.
DEMO_LOGIN=true

# Initial super administrator created by the seed (password is hashed with scrypt; never logged)
SEED_ADMIN_EMAIL=admin@veolia.example
SEED_ADMIN_PASSWORD=
# Password applied to the seeded demo role accounts (analyst, editor, viewer…). Leave empty to disable password login for them.
DEMO_USERS_PASSWORD=

# Background jobs
JOBS_ENABLED=true
JOBS_POLL_MS=2000

# E-mail delivery for scheduled reports and alerts (optional).
# Until SMTP_HOST is set, deliveries are recorded as "not sent — no e-mail provider configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Technical SEO crawler
CRAWLER_USER_AGENT=VeoliaDigitalIntelligenceAudit/1.0 (+internal)
